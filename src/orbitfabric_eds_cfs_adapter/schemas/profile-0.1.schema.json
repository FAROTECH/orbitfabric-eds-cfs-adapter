{
  "$id": "https://orbitfabric.dev/adapters/eds-cfs/profile-0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrbitFabric EDS-cFS Projection Profile",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "targetName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "topicRef": {
      "type": "string",
      "pattern": "^CFE_MISSION/[A-Za-z_][A-Za-z0-9_]*$"
    },
    "coreSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "commands",
            "packets"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "domain",
        "id"
      ]
    },
    "telemetrySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "telemetry"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "domain",
        "id"
      ]
    }
  },
  "properties": {
    "kind": {
      "const": "orbitfabric.projection_profile"
    },
    "profile_version": {
      "const": "0.1-candidate"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "orbitfabric-eds-cfs"
        },
        "schema_version": {
          "const": "0.1-candidate"
        }
      },
      "required": [
        "id",
        "schema_version"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package_name": {
              "$ref": "#/$defs/targetName"
            },
            "component_name": {
              "$ref": "#/$defs/targetName"
            }
          },
          "required": [
            "package_name",
            "component_name"
          ]
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/targetName"
                },
                "topic_ref": {
                  "$ref": "#/$defs/topicRef"
                }
              },
              "required": [
                "name",
                "topic_ref"
              ]
            },
            "telemetry": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/targetName"
                },
                "topic_ref": {
                  "$ref": "#/$defs/topicRef"
                }
              },
              "required": [
                "name",
                "topic_ref"
              ]
            }
          },
          "required": [
            "command",
            "telemetry"
          ]
        }
      },
      "required": [
        "eds",
        "interfaces"
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "project",
              "do_not_project"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/coreSource"
            }
          },
          "config": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "intent",
          "sources",
          "config"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "do_not_project"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "config": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "project"
                },
                "sources": {
                  "prefixItems": [
                    {
                      "properties": {
                        "domain": {
                          "const": "commands"
                        }
                      },
                      "required": [
                        "domain"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "intent",
                "sources"
              ]
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "function_code": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "function_code"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "project"
                },
                "sources": {
                  "prefixItems": [
                    {
                      "properties": {
                        "domain": {
                          "const": "packets"
                        }
                      },
                      "required": [
                        "domain"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "intent",
                "sources"
              ]
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "source": {
                            "$ref": "#/$defs/telemetrySource"
                          }
                        },
                        "required": [
                          "source"
                        ]
                      }
                    }
                  },
                  "required": [
                    "fields"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "profile_version",
    "profile",
    "integration",
    "settings",
    "bindings"
  ]
}
