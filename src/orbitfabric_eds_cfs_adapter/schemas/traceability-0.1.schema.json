{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitfabric.dev/adapters/eds-cfs/traceability-0.1.schema.json",
  "title": "OrbitFabric EDS-cFS Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "traceability_version",
    "integration",
    "profile",
    "artifact",
    "mappings",
    "resolutions"
  ],
  "properties": {
    "kind": {
      "const": "orbitfabric.eds_cfs.traceability"
    },
    "traceability_version": {
      "const": "0.1-candidate"
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version"
      ],
      "properties": {
        "id": {
          "const": "orbitfabric-eds-cfs"
        },
        "schema_version": {
          "const": "0.1-candidate"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "media_type",
        "sha256",
        "package",
        "component"
      ],
      "properties": {
        "id": {
          "const": "eds.package"
        },
        "kind": {
          "const": "ccsds.sois.eds.xml"
        },
        "media_type": {
          "const": "application/xml"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "id"
      ],
      "properties": {
        "domain": {
          "enum": [
            "commands",
            "packets",
            "telemetry"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kind",
        "id"
      ],
      "properties": {
        "namespace": {
          "const": "cfs-eds"
        },
        "kind": {
          "enum": [
            "package",
            "component",
            "container_type",
            "entry",
            "interface",
            "variable"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources",
        "profile_bindings",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "profile_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mapping",
        "binding",
        "sources",
        "property",
        "value",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "origin": {
          "enum": [
            "core",
            "adapter_default",
            "profile"
          ]
        }
      }
    }
  }
}
